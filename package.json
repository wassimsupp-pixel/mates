{
  "name": "mates-app",
  "version": "1.0.0",
  "private": true,
  "description": "Mates — find sport partners and book courts (Node + Express + SQLite)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "build": "npm run build:css",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js --reset",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "lucide": "^0.469.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
